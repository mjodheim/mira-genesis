# candidate exists. JSON fixtures are already covered by the experiments/M1* rule above.
experiments/M106/*.md text eol=lf
metamorphosis/m106_runtime.py text eol=lf
scripts/*m106*.py text eol=lf
tests/test_m106_*.py text eol=lf

