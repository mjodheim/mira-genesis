results/local/
# Development outputs are reproducible through `scripts/run_*_development.py` and
# published as CI artifacts. Only canonical results are versioned.
results/*_development.json

# Sealed blind-bank material. A payload, its plaintext or a decryption key in this public
# repository would destroy the experiment it belongs to; `check_blind_bank_leakage.py` enforces
# that these entries exist rather than trusting them.
*.blind-bank-payload.json
*.blind-bank-plaintext
*.blind-bank.key
*.blind-bank.age
blind-bank-workspace/

# M093 transformation experiment runtime state (regenerated on each run).
.m093-state.json
.m093-backup-*

# M094 adoption state and the preserved original the rollback restores from. Written into the
# repository root by a canonical run, which also writes a digest-bearing result: without this
# they would sit untracked beside it and could be committed into the same change.
.m094-state.json
.m094-backup-*
